rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security primitives and helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'wfernando.aguilarm@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    // Sin HU-09 no hay rol moderador: la revisión de rutas la hace el admin.

    // Entity validation blueprints
    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 150 &&
             data.role in ['user', 'admin'] &&
             data.isBlocked is bool &&
             data.createdAt is number &&
             (!('username' in data) || (data.username is string && data.username.size() <= 80)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('summitsCount' in data) || (data.summitsCount is number && data.summitsCount >= 0)) &&
             (!('gpsAccuracy' in data) || (data.gpsAccuracy is string && data.gpsAccuracy.size() <= 80));
    }

    function isValidRoute(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.difficulty in ['facil', 'moderado', 'dificil', 'experto'] &&
             data.status in ['draft', 'in_review', 'published', 'rejected'] &&
             data.creatorId is string && data.creatorId.size() > 0 && data.creatorId.size() <= 128 &&
             data.distanceKm is number && data.distanceKm >= 0 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('region' in data) || (data.region is string && data.region.size() <= 150)) &&
             (!('modality' in data) || (data.modality in ['solo', 'acompañado'])) &&
             (!('isPrivate' in data) || data.isPrivate is bool) &&
             (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 150)) &&
             (!('durationMinutes' in data) || (data.durationMinutes is number && data.durationMinutes >= 0)) &&
             (!('waypoints' in data) || (data.waypoints is list && data.waypoints.size() <= 5000)) &&
             (!('checkpoints' in data) || (data.checkpoints is list && data.checkpoints.size() <= 100)) &&
             (!('photos' in data) || (data.photos is list && data.photos.size() <= 50)) &&
             (!('createdAt' in data) || data.createdAt is number) &&
             (!('updatedAt' in data) || data.updatedAt is number) &&
             (!('moderationNotes' in data) || (data.moderationNotes is string && data.moderationNotes.size() <= 2000)) &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 150)) &&
             (!('reviewedAt' in data) || data.reviewedAt is number) &&
             (!('artifacts' in data) || isValidRouteArtifacts(data.artifacts, data.id, data.status == 'published')) &&
             (!('preview' in data) || isValidRoutePreview(data.preview)) &&
             (data.status != 'published' ||
               ('artifacts' in data && isValidRouteArtifacts(data.artifacts, data.id, true) &&
                'preview' in data && isValidRoutePreview(data.preview) && !('waypoints' in data)));
    }

    function isValidRoutePreview(data) {
      return data is map &&
             data.keys().hasAll(['version', 'encoding', 'polyline', 'pointCount', 'bbox']) &&
             data.keys().hasOnly(['version', 'encoding', 'polyline', 'pointCount', 'bbox']) &&
             data.version is int && data.version == 1 &&
             data.encoding == 'polyline6' &&
             data.polyline is string && data.polyline.size() > 0 && data.polyline.size() <= 4096 &&
             data.pointCount is int && data.pointCount >= 2 && data.pointCount <= 200 &&
             data.bbox is map &&
             data.bbox.keys().hasAll(['minLng', 'minLat', 'maxLng', 'maxLat']) &&
             data.bbox.keys().hasOnly(['minLng', 'minLat', 'maxLng', 'maxLat']) &&
             data.bbox.minLng is number && data.bbox.minLng >= -180 && data.bbox.minLng <= 180 &&
             data.bbox.maxLng is number && data.bbox.maxLng >= -180 && data.bbox.maxLng <= 180 &&
             data.bbox.minLat is number && data.bbox.minLat >= -90 && data.bbox.minLat <= 90 &&
             data.bbox.maxLat is number && data.bbox.maxLat >= -90 && data.bbox.maxLat <= 90 &&
             data.bbox.minLng <= data.bbox.maxLng && data.bbox.minLat <= data.bbox.maxLat;
    }

    // Route bytes never belong in Firestore. These fields are a metadata-only
    // contract for the paired Storage objects used by the offline bundle.
    function isValidRouteArtifact(data, kind, expectedName, expectedMime, requireUploaded) {
      return data is map &&
             data.kind == kind &&
             data.fileName == expectedName &&
             data.mimeType == expectedMime &&
             data.version is int && data.version >= 1 &&
             data.storagePath is string &&
             data.byteSize is number && data.byteSize >= 0 && data.byteSize <= 524288000 &&
             (!('sha256' in data) || (data.sha256 is string && data.sha256.matches('^[0-9a-fA-F]{64}$'))) &&
             data.status in ['pending', 'uploading', 'uploaded', 'failed'] &&
             (!requireUploaded || data.status == 'uploaded') &&
             data.updatedAt is number &&
             (!('error' in data) || (data.error is string && data.error.size() <= 500));
    }

    function isValidRouteArtifacts(data, routeId, requireUploaded) {
      return data is map &&
             data.keys().hasAll(['version', 'gpx', 'pmtiles']) &&
             data.keys().hasOnly(['version', 'gpx', 'pmtiles']) &&
             data.version is int && data.version >= 1 &&
             isValidRouteArtifact(data.gpx, 'gpx', 'route.gpx', 'application/gpx+xml', requireUploaded) &&
             isValidRouteArtifact(data.pmtiles, 'pmtiles', 'basemap.pmtiles', 'application/vnd.pmtiles', requireUploaded) &&
             data.gpx.version == data.version &&
             data.pmtiles.version == data.version &&
             data.gpx.storagePath.matches('^routes/' + routeId + '/v[1-9][0-9]*/route\\.gpx$') &&
             data.pmtiles.storagePath.matches('^routes/' + routeId + '/v[1-9][0-9]*/basemap\\.pmtiles$');
    }

    function isValidActivity(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.routeId is string && data.routeId.size() <= 128 &&
             data.status in ['in_progress', 'paused', 'completed', 'incomplete'] &&
             data.distanceCoveredKm is number && data.distanceCoveredKm >= 0 &&
             // Track points are local-only. GPX bytes are in Storage.
             !('recordedPoints' in data) &&
             (!('gpx' in data) || (
               data.gpx is map &&
               data.gpx.storagePath is string &&
               data.gpx.storagePath.matches('^users/[a-zA-Z0-9_\\-]+/activities/[a-zA-Z0-9_\\-]+/activity\\.gpx$') &&
               data.gpx.fileName == 'activity.gpx' &&
               data.gpx.mimeType == 'application/gpx+xml' &&
               data.gpx.status in ['pending', 'uploading', 'uploaded', 'failed'] &&
               data.gpx.updatedAt is number &&
               (!('byteSize' in data.gpx) || (data.gpx.byteSize is number && data.gpx.byteSize >= 0 && data.gpx.byteSize <= 10485760)) &&
               (!('sha256' in data.gpx) || (data.gpx.sha256 is string && data.gpx.sha256.size() <= 128)) &&
                (!('error' in data.gpx) || (data.gpx.error is string && data.gpx.error.size() <= 500))
              )) &&
              // HU-12 — paradas con foto local (solo metadatos + URIs, ≤100).
              (!('checkpoints' in data) || (data.checkpoints is list && data.checkpoints.size() <= 100));
    }

    function isValidReview(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.routeId is string && data.routeId.size() <= 128 &&
             data.reviewerId is string && data.reviewerId == request.auth.uid &&
             data.status in ['approved', 'rejected'] &&
             (!('observations' in data) || (data.observations is string && data.observations.size() <= 2000));
    }

    function isValidAccountLog(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.action in ['block', 'unblock', 'role_change'] &&
             data.actorId is string && data.actorId.size() > 0 && data.actorId.size() <= 128 &&
             (!('actorName' in data) || (data.actorName is string && data.actorName.size() <= 150)) &&
             (!('previousRole' in data) || data.previousRole in ['user', 'admin']) &&
             (!('newRole' in data) || data.newRole in ['user', 'admin']) &&
             data.createdAt is number;
    }

    // Users collection rules (PII, Role protection, Self-management)
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUser(incoming()) &&
                       incoming().uid == request.auth.uid &&
                       (incoming().role == 'user' || isAdmin()) &&
                       incoming().isBlocked == false;
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       (
                         (isOwner(userId) &&
                          incoming().uid == existing().uid &&
                          incoming().role == existing().role &&
                          incoming().isBlocked == existing().isBlocked &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'avatarUrl', 'summitsCount', 'gpsAccuracy']))
                         || isAdmin()
                       );
      allow delete: if isAdmin();
    }

    // Routes collection rules (Catalog, Collaboration, Admin review)
    match /routes/{routeId} {
      allow get: if resource.data.status == 'published' ||
                     (isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin()));
      allow list: if resource.data.status == 'published' ||
                      (isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() &&
                       isValidId(routeId) &&
                       isValidRoute(incoming()) &&
                       incoming().id == routeId &&
                       incoming().creatorId == request.auth.uid &&
                       (incoming().status == 'draft' || incoming().status == 'in_review');
      allow update: if isSignedIn() &&
                       isValidId(routeId) &&
                       isValidRoute(incoming()) &&
                       incoming().id == routeId &&
                       (
                         (resource.data.creatorId == request.auth.uid &&
                          incoming().creatorId == existing().creatorId &&
                          incoming().id == existing().id &&
                          incoming().status != 'published' &&
                           (existing().status == 'draft' || existing().status == 'rejected' ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'waypoints', 'checkpoints', 'photos', 'updatedAt', 'startPoint', 'endPoint', 'distanceKm', 'durationMinutes', 'difficulty', 'modality', 'region', 'isPrivate'])))
                         || isAdmin()
                       );
      allow delete: if isSignedIn() &&
                       ((resource.data.creatorId == request.auth.uid && resource.data.status == 'draft') || isAdmin());
    }

    // Activities collection rules (User privacy & GPS logs)
    match /activities/{activityId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(activityId) &&
                       isValidActivity(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if isSignedIn() &&
                       isValidId(activityId) &&
                       isValidActivity(incoming()) &&
                       resource.data.userId == request.auth.uid &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() &&
                       (resource.data.userId == request.auth.uid || isAdmin());

      // GPS points/chunks are intentionally not a cloud data path. The default
      // deny rule below also protects legacy `points` documents from new use.
      match /points/{chunkId} {
        allow read, write: if false;
      }
    }

    // Reviews collection rules (Auditing — sin HU-09 solo el admin las emite)
    match /reviews/{reviewId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() &&
                       isValidId(reviewId) &&
                       isValidReview(incoming());
      allow update: if isAdmin() &&
                       isValidId(reviewId) &&
                       isValidReview(incoming());
      allow delete: if isAdmin();
    }

    // Account logs collection rules (HU-10 T7 — bitácora de bloqueo/desbloqueo/rol,
    // escrita y leída solo por admin; el actor debe ser el propio admin autenticado).
    match /accountLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(logId) &&
                       isValidAccountLog(incoming()) &&
                       logId == incoming().id &&
                       incoming().actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
